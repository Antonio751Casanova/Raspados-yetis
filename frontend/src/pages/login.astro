---
/**
 * Pagina: Login / Registro
 * Autenticacion para YetiControl
 */
import '../styles/global.css';
const API_BASE = import.meta.env.PUBLIC_API_BASE ?? 'http://127.0.0.1:8001/api/v1';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>YetiControl | Acceso</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-slate-100 text-texto-900 font-sans antialiased">
    <div class="min-h-screen flex items-center justify-center px-4 py-10 bg-gradient-to-br from-slate-100 via-slate-50 to-blue-100/50">
      <div class="w-full max-w-md bg-white shadow-2xl rounded-2xl border border-superficie-200 overflow-hidden">
        <div class="px-8 pt-8 pb-6">
          <div class="text-center">
            <div class="mx-auto w-12 h-12 rounded-xl bg-gradient-to-br from-yeti-600 to-yeti-700 flex items-center justify-center text-white text-lg font-bold">YC</div>
            <h1 class="mt-4 text-2xl font-extrabold tracking-wide">YetiControl</h1>
            <p class="text-[11px] text-texto-400 uppercase tracking-[0.3em] mt-1">ERP SISTEMA</p>
            <p class="text-sm text-texto-500 mt-3">Acceso seguro al panel operativo</p>
          </div>

          <div class="mt-6 grid grid-cols-2 rounded-xl bg-superficie-50 p-1">
            <button id="tab-login" class="px-3 py-2 text-sm font-semibold rounded-lg bg-white shadow-sm text-yeti-700">Iniciar Sesion</button>
            <button id="tab-register" class="px-3 py-2 text-sm font-semibold rounded-lg text-texto-500 hover:text-yeti-700">Crear Cuenta</button>
          </div>

          <form id="form-login" class="mt-6 space-y-4">
            <div>
              <label class="block text-xs font-semibold text-texto-600 mb-1" for="login-email">Correo Electronico</label>
              <input id="login-email" type="email" required placeholder="nombre@empresa.com"
                     class="w-full px-3 py-2.5 text-sm border border-superficie-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-yeti-500/30 focus:border-yeti-400" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-texto-600 mb-1" for="login-password">Contrasena</label>
              <div class="relative">
                <input id="login-password" type="password" required placeholder="********"
                       class="w-full px-3 py-2.5 text-sm border border-superficie-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-yeti-500/30 focus:border-yeti-400" />
                <button type="button" id="toggle-login-password"
                        class="absolute right-2 top-1/2 -translate-y-1/2 text-xs text-texto-500 hover:text-yeti-700">Ver</button>
              </div>
            </div>
            <div id="login-error" class="hidden text-xs text-red-600 bg-red-50 border border-red-100 px-3 py-2 rounded-lg"></div>
            <button type="submit"
                    class="w-full py-2.5 rounded-lg bg-yeti-600 text-white text-sm font-semibold hover:bg-yeti-700">
              Acceder
            </button>
            <button type="button" id="open-forgot" class="w-full text-xs text-texto-500 hover:text-yeti-700">
              ¿Olvidaste tu contraseña?
            </button>
          </form>

          <form id="form-register" class="mt-6 space-y-4 hidden">
            <div>
              <label class="block text-xs font-semibold text-texto-600 mb-1" for="register-name">Nombre de Usuario</label>
              <input id="register-name" type="text" required placeholder="Tu nombre"
                     class="w-full px-3 py-2.5 text-sm border border-superficie-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-yeti-500/30 focus:border-yeti-400" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-texto-600 mb-1" for="register-email">Correo Electronico</label>
              <input id="register-email" type="email" required placeholder="nombre@empresa.com"
                     class="w-full px-3 py-2.5 text-sm border border-superficie-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-yeti-500/30 focus:border-yeti-400" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-texto-600 mb-1" for="register-password">Contrasena</label>
              <div class="relative">
                <input id="register-password" type="password" required minlength="8" placeholder="Minimo 8 caracteres"
                       class="w-full px-3 py-2.5 text-sm border border-superficie-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-yeti-500/30 focus:border-yeti-400" />
                <button type="button" id="toggle-register-password"
                        class="absolute right-2 top-1/2 -translate-y-1/2 text-xs text-texto-500 hover:text-yeti-700">Ver</button>
              </div>
            </div>
            <div id="register-error" class="hidden text-xs text-red-600 bg-red-50 border border-red-100 px-3 py-2 rounded-lg"></div>
            <button type="submit"
                    class="w-full py-2.5 rounded-lg bg-yeti-600 text-white text-sm font-semibold hover:bg-yeti-700">
              Crear Cuenta
            </button>
          </form>
        </div>
        <div class="px-8 py-4 bg-superficie-50 text-[11px] text-texto-400 text-center">
          Acceso protegido · YetiControl
        </div>
      </div>
    </div>

    <div id="forgot-modal" class="fixed inset-0 hidden items-center justify-center bg-black/40 px-4">
      <div class="w-full max-w-sm bg-white rounded-2xl shadow-xl border border-superficie-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-superficie-200">
          <h2 class="text-sm font-semibold text-texto-800">Recuperar contraseña</h2>
        </div>
        <form id="form-forgot" class="px-6 py-5 space-y-4">
          <p class="text-xs text-texto-500">Enviaremos un enlace de recuperación al correo registrado.</p>
          <div>
            <label class="block text-xs font-semibold text-texto-600 mb-1" for="forgot-email">Correo Electronico</label>
            <input id="forgot-email" type="email" required placeholder="nombre@empresa.com"
                   class="w-full px-3 py-2.5 text-sm border border-superficie-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-yeti-500/30 focus:border-yeti-400" />
          </div>
          <div id="forgot-error" class="hidden text-xs text-red-600 bg-red-50 border border-red-100 px-3 py-2 rounded-lg"></div>
          <div id="forgot-success" class="hidden text-xs text-ganancia-700 bg-ganancia-50 border border-ganancia-100 px-3 py-2 rounded-lg"></div>
          <div class="flex items-center justify-end gap-2">
            <button type="button" id="close-forgot"
                    class="px-3 py-2 text-xs font-semibold text-texto-600 hover:text-texto-800">Cancelar</button>
            <button type="submit"
                    class="px-3 py-2 text-xs font-semibold rounded-lg bg-yeti-600 text-white hover:bg-yeti-700">Enviar</button>
          </div>
        </form>
      </div>
    </div>

    <script>
      const API_BASE = ${JSON.stringify(API_BASE)};
      const tokenKey = 'auth_token';
      const redirectUrl = '/';

      if (localStorage.getItem(tokenKey)) {
        window.location.replace(redirectUrl);
      }

      const tabLogin = document.getElementById('tab-login');
      const tabRegister = document.getElementById('tab-register');
      const formLogin = document.getElementById('form-login');
      const formRegister = document.getElementById('form-register');
      const loginError = document.getElementById('login-error');
      const registerError = document.getElementById('register-error');
      const forgotModal = document.getElementById('forgot-modal');
      const forgotError = document.getElementById('forgot-error');
      const forgotSuccess = document.getElementById('forgot-success');

      function setTab(tab) {
        if (tab === 'login') {
          tabLogin.classList.add('bg-white', 'text-yeti-700', 'shadow-sm');
          tabRegister.classList.remove('bg-white', 'text-yeti-700', 'shadow-sm');
          tabRegister.classList.add('text-texto-500');
          formLogin.classList.remove('hidden');
          formRegister.classList.add('hidden');
        } else {
          tabRegister.classList.add('bg-white', 'text-yeti-700', 'shadow-sm');
          tabLogin.classList.remove('bg-white', 'text-yeti-700', 'shadow-sm');
          tabLogin.classList.add('text-texto-500');
          formRegister.classList.remove('hidden');
          formLogin.classList.add('hidden');
        }
        clearMessage(loginError);
        clearMessage(registerError);
      }

      function clearMessage(el) {
        if (!el) return;
        el.classList.add('hidden');
        el.textContent = '';
      }

      function showMessage(el, message) {
        if (!el) return;
        el.textContent = message;
        el.classList.remove('hidden');
      }

      function formatErrors(errors) {
        if (!errors) return '';
        const mensajes = Object.values(errors).flat();
        return mensajes.join(' ');
      }

      function togglePassword(inputId, buttonId) {
        const input = document.getElementById(inputId);
        const button = document.getElementById(buttonId);
        if (!input || !button) return;
        button.addEventListener('click', () => {
          const isPassword = input.type === 'password';
          input.type = isPassword ? 'text' : 'password';
          button.textContent = isPassword ? 'Ocultar' : 'Ver';
        });
      }

      tabLogin?.addEventListener('click', () => setTab('login'));
      tabRegister?.addEventListener('click', () => setTab('register'));

      togglePassword('login-password', 'toggle-login-password');
      togglePassword('register-password', 'toggle-register-password');

      formLogin?.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearMessage(loginError);
        const email = document.getElementById('login-email')?.value || '';
        const password = document.getElementById('login-password')?.value || '';

        try {
          const res = await fetch(`${API_BASE}/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ email, password }),
          });
          const data = await res.json();
          if (!res.ok || !data.exito) {
            showMessage(loginError, data.mensaje || formatErrors(data.errors) || 'Credenciales incorrectas.');
            return;
          }
          localStorage.setItem(tokenKey, data.datos?.token);
          window.location.replace(redirectUrl);
        } catch {
          showMessage(loginError, 'No se pudo conectar con el servidor.');
        }
      });

      formRegister?.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearMessage(registerError);
        const name = document.getElementById('register-name')?.value || '';
        const email = document.getElementById('register-email')?.value || '';
        const password = document.getElementById('register-password')?.value || '';

        try {
          const res = await fetch(`${API_BASE}/auth/register`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ name, email, password }),
          });
          const data = await res.json();
          if (!res.ok || !data.exito) {
            showMessage(registerError, data.mensaje || formatErrors(data.errors) || 'No se pudo crear la cuenta.');
            return;
          }
          localStorage.setItem(tokenKey, data.datos?.token);
          window.location.replace(redirectUrl);
        } catch {
          showMessage(registerError, 'No se pudo conectar con el servidor.');
        }
      });

      document.getElementById('open-forgot')?.addEventListener('click', () => {
        forgotModal?.classList.remove('hidden');
        forgotModal?.classList.add('flex');
        clearMessage(forgotError);
        clearMessage(forgotSuccess);
      });

      function closeForgot() {
        forgotModal?.classList.add('hidden');
        forgotModal?.classList.remove('flex');
        clearMessage(forgotError);
        clearMessage(forgotSuccess);
      }

      document.getElementById('close-forgot')?.addEventListener('click', closeForgot);
      forgotModal?.addEventListener('click', (event) => {
        if (event.target === forgotModal) closeForgot();
      });

      document.getElementById('form-forgot')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearMessage(forgotError);
        clearMessage(forgotSuccess);
        const email = document.getElementById('forgot-email')?.value || '';

        try {
          const res = await fetch(`${API_BASE}/auth/password/email`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ email }),
          });
          const data = await res.json();
          if (!res.ok || !data.exito) {
            showMessage(forgotError, data.mensaje || formatErrors(data.errors) || 'No se pudo enviar el enlace.');
            return;
          }
          showMessage(forgotSuccess, 'Revisa tu correo para continuar la recuperacion.');
        } catch {
          showMessage(forgotError, 'No se pudo conectar con el servidor.');
        }
      });
    </script>
  </body>
</html>
