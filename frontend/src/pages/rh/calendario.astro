---
/**
 * Página: Calendario de Asignaciones
 * Módulo E — Recursos Humanos · Raspados Yeti ERP
 */
import Layout from '../../layouts/Layout.astro';
---

<Layout titulo="Calendario de Staff" descripcion="Calendario de asignaciones de personal por evento — Raspados Yeti ERP">

  <!-- Encabezado -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-texto-900">Calendario de Asignaciones</h1>
      <p class="text-sm text-texto-500 mt-1">Vista mensual del personal asignado por evento</p>
    </div>
    <div class="flex items-center gap-3">
      <button id="btn-mes-prev" class="w-9 h-9 rounded-lg border border-superficie-300 flex items-center justify-center hover:bg-superficie-100 transition-colors text-texto-600">‹</button>
      <span id="lbl-mes" class="text-sm font-semibold text-texto-800 min-w-[130px] text-center capitalize"></span>
      <button id="btn-mes-next" class="w-9 h-9 rounded-lg border border-superficie-300 flex items-center justify-center hover:bg-superficie-100 transition-colors text-texto-600">›</button>
    </div>
  </div>

  <!-- Leyenda de estados de asignación -->
  <div class="flex flex-wrap gap-3 mb-5">
    <span class="inline-flex items-center gap-1.5 text-xs text-texto-600 font-medium"><span class="w-3 h-3 rounded-full bg-yellow-400 inline-block"></span>Pendiente</span>
    <span class="inline-flex items-center gap-1.5 text-xs text-texto-600 font-medium"><span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span>Confirmado</span>
    <span class="inline-flex items-center gap-1.5 text-xs text-texto-600 font-medium"><span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>Asistió</span>
    <span class="inline-flex items-center gap-1.5 text-xs text-texto-600 font-medium"><span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>Faltó</span>
  </div>

  <!-- Grid del Calendario -->
  <div class="bg-white rounded-xl border border-superficie-200 shadow-sm overflow-hidden">
    <!-- Cabecera días de semana -->
    <div class="grid grid-cols-7 border-b border-superficie-200">
      {['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'].map(d => (
        <div class="py-3 text-center text-xs font-semibold text-texto-500 uppercase tracking-wide">{d}</div>
      ))}
    </div>
    <!-- Celdas del mes -->
    <div id="cal-grid" class="grid grid-cols-7 auto-rows-fr"></div>
  </div>

  <!-- Panel lateral: Detalle del día seleccionado -->
  <div id="panel-dia" class="hidden mt-6 bg-white rounded-xl border border-yeti-200 shadow-sm">
    <div class="px-6 py-4 border-b border-superficie-100 bg-yeti-50 rounded-t-xl">
      <h2 id="panel-dia-titulo" class="text-sm font-semibold text-yeti-800">Eventos del día</h2>
    </div>
    <div id="panel-dia-contenido" class="divide-y divide-superficie-100"></div>
  </div>

</Layout>

<script>
  const API = 'http://127.0.0.1:8001/api/v1';

  function esc(t: any) { return String(t ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  const ESTADO_COLORS: Record<string,string> = {
    Confirmado: 'bg-blue-100 border-blue-300 text-blue-800',
    Cotizado:   'bg-yellow-100 border-yellow-300 text-yellow-800',
    'Anticipo Pagado': 'bg-orange-100 border-orange-300 text-orange-700',
    Completado: 'bg-green-100 border-green-300 text-green-800',
    Cancelado:  'bg-red-100 border-red-300 text-red-800',
  };

  // ── Estado del Calendario ─────────────────────────────────────────────
  let ahora = new Date();
  let año   = ahora.getFullYear();
  let mes   = ahora.getMonth() + 1; // 1-12
  let eventosDelMes: any[] = [];

  function mesStr() { return `${año}-${String(mes).padStart(2,'0')}`; }

  // ── Cargar eventos del mes ────────────────────────────────────────────
  async function cargarMes() {
    const lbl = document.getElementById('lbl-mes')!;
    lbl.textContent = new Date(año, mes - 1, 1).toLocaleDateString('es-MX', { month: 'long', year: 'numeric' });

    try {
      const res  = await fetch(`${API}/asignaciones/calendario?mes=${mesStr()}`);
      const json = await res.json();
      eventosDelMes = json.datos?.eventos ?? [];
      renderCalendario();
    } catch { console.error('Error al cargar calendario'); }
  }

  // ── Renderizar grilla ─────────────────────────────────────────────────
  function renderCalendario() {
    const grid    = document.getElementById('cal-grid')!;
    const primerDia = new Date(año, mes - 1, 1).getDay(); // 0=Dom
    const diasMes   = new Date(año, mes, 0).getDate();

    // Agrupar eventos por fecha
    const porFecha: Record<string, any[]> = {};
    eventosDelMes.forEach(ev => {
      const k = ev.fecha_evento?.substring(0,10);
      if (!k) return;
      if (!porFecha[k]) porFecha[k] = [];
      porFecha[k].push(ev);
    });

    const hoyStr = new Date().toISOString().substring(0,10);

    let html = '';

    // Celdas vacías del inicio
    for (let i = 0; i < primerDia; i++) {
      html += '<div class="min-h-[110px] border-b border-r border-superficie-100 bg-superficie-50/40"></div>';
    }

    for (let d = 1; d <= diasMes; d++) {
      const fechaStr = `${año}-${String(mes).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
      const evs      = porFecha[fechaStr] ?? [];
      const esHoy    = fechaStr === hoyStr;

      html += `<div class="min-h-[110px] border-b border-r border-superficie-100 p-2 cursor-pointer hover:bg-yeti-50/50 transition-colors cal-dia" data-fecha="${fechaStr}">
        <span class="text-xs font-semibold ${esHoy ? 'bg-yeti-600 text-white w-6 h-6 rounded-full flex items-center justify-center' : 'text-texto-600'}">${d}</span>
        <div class="mt-1 space-y-0.5">
          ${evs.slice(0,3).map(ev => {
            const colorClass = ESTADO_COLORS[ev.estado] ?? 'bg-superficie-100 border-superficie-300 text-texto-600';
            const staffCnt   = ev.asignaciones?.length ?? 0;
            return `<div class="truncate text-[10px] font-medium px-1.5 py-0.5 rounded border ${colorClass}">
              ${esc(ev.cliente_nombre)} <span class="opacity-70">(${staffCnt})</span>
            </div>`;
          }).join('')}
          ${evs.length > 3 ? `<div class="text-[10px] text-texto-400 px-1">+${evs.length - 3} más</div>` : ''}
        </div>
      </div>`;
    }

    // Celdas vacías al final para completar 7 columnas
    const totalCeldas = primerDia + diasMes;
    const resto = 7 - (totalCeldas % 7);
    if (resto < 7) {
      for (let i = 0; i < resto; i++) {
        html += '<div class="min-h-[110px] border-b border-r border-superficie-100 bg-superficie-50/40"></div>';
      }
    }

    grid.innerHTML = html;

    // Click en día
    document.querySelectorAll('.cal-dia').forEach(cel =>
      cel.addEventListener('click', () => mostrarDetalleDia((cel as HTMLElement).dataset.fecha!)));
  }

  // ── Detalle del día ───────────────────────────────────────────────────
  function mostrarDetalleDia(fecha: string) {
    const evs = eventosDelMes.filter(ev => ev.fecha_evento?.startsWith(fecha));
    const panel = document.getElementById('panel-dia')!;
    const titulo = document.getElementById('panel-dia-titulo')!;
    const cont   = document.getElementById('panel-dia-contenido')!;

    const fechaLabel = new Date(fecha + 'T12:00:00').toLocaleDateString('es-MX', { weekday:'long', day:'numeric', month:'long' });
    titulo.textContent = `Eventos — ${fechaLabel}`;

    if (!evs.length) {
      cont.innerHTML = '<div class="px-6 py-6 text-sm text-texto-400 text-center">Sin eventos este día.</div>';
    } else {
      cont.innerHTML = evs.map(ev => {
        const asigs = ev.asignaciones ?? [];
        return `<div class="px-6 py-4">
          <div class="flex items-center justify-between gap-4 mb-2">
            <div>
              <p class="text-sm font-semibold text-texto-900">${esc(ev.cliente_nombre)}</p>
              <p class="text-xs text-texto-500">${esc(ev.municipio)} · ${ev.hora_inicio ?? '—'} – ${ev.hora_fin ?? '—'}</p>
            </div>
            <span class="text-xs font-medium px-2.5 py-1 rounded-full ${ESTADO_COLORS[ev.estado] ?? 'bg-superficie-100 text-texto-600'}">${esc(ev.estado)}</span>
          </div>
          ${asigs.length ? `
          <div class="flex flex-wrap gap-2 mt-2">
            ${asigs.map((a: any) => `
              <span class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full bg-superficie-100 text-texto-700">
                <img src="${esc(a.empleado?.foto_url ?? '')}" class="w-4 h-4 rounded-full object-cover" />
                ${esc(`${a.empleado?.nombre ?? ''} ${a.empleado?.apellido_paterno ?? ''}`)}
                ${a.rol_staff ? `<span class="ml-1 text-[10px] font-medium" style="color:${a.rol_staff.color_hex}">${esc(a.rol_staff.nombre)}</span>` : ''}
              </span>`).join('')}
          </div>` : '<p class="text-xs text-texto-400 mt-1">Sin staff asignado.</p>'}
        </div>`;
      }).join('');
    }

    panel.classList.remove('hidden');
    panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ── Navegación ────────────────────────────────────────────────────────
  document.getElementById('btn-mes-prev')!.addEventListener('click', () => {
    mes--;
    if (mes < 1) { mes = 12; año--; }
    cargarMes();
  });
  document.getElementById('btn-mes-next')!.addEventListener('click', () => {
    mes++;
    if (mes > 12) { mes = 1; año++; }
    cargarMes();
  });

  cargarMes();
</script>
