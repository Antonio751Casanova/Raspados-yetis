---
/**
 * Página: Configuración
 *
 * Opciones de personalización del sistema:
 * - Cambio de tema (claro / oscuro)
 */
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Configuración" descripcion="Personalización y ajustes del sistema ERP Raspados Yeti">

  <div class="max-w-2xl">

    <!-- Encabezado -->
    <div class="mb-8">
      <h3 class="text-2xl font-bold text-texto-900">Ajustes del Sistema</h3>
      <p class="text-texto-500 mt-1">Personaliza la apariencia y comportamiento del ERP.</p>
    </div>

    <!-- Sección: Apariencia -->
    <div class="bg-white rounded-2xl border border-superficie-200 shadow-card overflow-hidden">

      <!-- Header de sección -->
      <div class="px-6 py-4 border-b border-superficie-200 bg-superficie-50">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-yeti-100 border border-yeti-200 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-yeti-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008z" />
            </svg>
          </div>
          <div>
            <h4 class="text-sm font-bold text-texto-900">Apariencia</h4>
            <p class="text-xs text-texto-500">Elige cómo se ve tu sistema</p>
          </div>
        </div>
      </div>

      <!-- Opciones de tema -->
      <div class="p-6 space-y-4">

        <!-- Tema Claro -->
        <button type="button" id="opt-theme-light"
          class="theme-option w-full flex items-center gap-4 p-4 rounded-xl border-2 transition-all cursor-pointer group hover:shadow-md">
          <!-- Preview mini -->
          <div class="w-16 h-12 rounded-lg border border-superficie-200 overflow-hidden shrink-0 shadow-sm">
            <div class="h-3 bg-gradient-to-r from-blue-500 to-blue-600"></div>
            <div class="h-9 bg-white flex items-end p-1 gap-0.5">
              <div class="w-2 h-3 bg-slate-200 rounded-sm"></div>
              <div class="w-2 h-5 bg-blue-200 rounded-sm"></div>
              <div class="w-2 h-4 bg-slate-200 rounded-sm"></div>
            </div>
          </div>
          <div class="flex-1 text-left">
            <p class="text-sm font-semibold text-texto-900">Modo Claro</p>
            <p class="text-xs text-texto-500">Fondo blanco con acentos azules. Ideal para espacios iluminados.</p>
          </div>
          <!-- Indicador de selección -->
          <div class="theme-check w-6 h-6 rounded-full border-2 flex items-center justify-center shrink-0 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-white hidden check-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
        </button>

        <!-- Tema Oscuro -->
        <button type="button" id="opt-theme-dark"
          class="theme-option w-full flex items-center gap-4 p-4 rounded-xl border-2 transition-all cursor-pointer group hover:shadow-md">
          <!-- Preview mini -->
          <div class="w-16 h-12 rounded-lg border border-superficie-200 overflow-hidden shrink-0 shadow-sm">
            <div class="h-3 bg-gradient-to-r from-blue-600 to-indigo-800"></div>
            <div class="h-9 bg-slate-800 flex items-end p-1 gap-0.5">
              <div class="w-2 h-3 bg-slate-600 rounded-sm"></div>
              <div class="w-2 h-5 bg-blue-400 rounded-sm"></div>
              <div class="w-2 h-4 bg-slate-600 rounded-sm"></div>
            </div>
          </div>
          <div class="flex-1 text-left">
            <p class="text-sm font-semibold text-texto-900">Modo Oscuro</p>
            <p class="text-xs text-texto-500">Fondo oscuro que reduce la fatiga visual. Ideal para uso nocturno.</p>
          </div>
          <!-- Indicador de selección -->
          <div class="theme-check w-6 h-6 rounded-full border-2 flex items-center justify-center shrink-0 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-white hidden check-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
        </button>

      </div>

      <!-- Footer de sección -->
      <div class="px-6 py-3 border-t border-superficie-200 bg-superficie-50">
        <p class="text-xs text-texto-400 flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
          </svg>
          Tu preferencia se guarda automáticamente en este navegador.
        </p>
      </div>
    </div>

  </div>

</Layout>

<script>
  // ─── Lógica de la página de Configuración ──────────────────

  const optLight = document.getElementById('opt-theme-light');
  const optDark = document.getElementById('opt-theme-dark');

  function aplicarSeleccionVisual(oscuro: boolean) {
    const activo = oscuro ? optDark : optLight;
    const inactivo = oscuro ? optLight : optDark;

    // Activo: borde azul + check visible
    activo?.classList.remove('border-superficie-200');
    activo?.classList.add('border-yeti-500', 'bg-yeti-50/50');
    const checkActivo = activo?.querySelector('.theme-check');
    if (checkActivo) {
      checkActivo.classList.remove('border-superficie-300');
      checkActivo.classList.add('border-yeti-500', 'bg-yeti-500');
    }
    const iconActivo = activo?.querySelector('.check-icon');
    iconActivo?.classList.remove('hidden');

    // Inactivo: borde gris + check oculto
    inactivo?.classList.add('border-superficie-200');
    inactivo?.classList.remove('border-yeti-500', 'bg-yeti-50/50');
    const checkInactivo = inactivo?.querySelector('.theme-check');
    if (checkInactivo) {
      checkInactivo.classList.add('border-superficie-300');
      checkInactivo.classList.remove('border-yeti-500', 'bg-yeti-500');
    }
    const iconInactivo = inactivo?.querySelector('.check-icon');
    iconInactivo?.classList.add('hidden');
  }

  function setTheme(dark: boolean) {
    if (dark) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    localStorage.setItem('yeti-theme', dark ? 'dark' : 'light');
    aplicarSeleccionVisual(dark);

    // Sincronizar el indicador del sidebar (si existe)
    const sidebarIcon = document.getElementById('sidebar-theme-icon');
    if (sidebarIcon) {
      sidebarIcon.textContent = dark ? '☀️' : '🌙';
    }
  }

  // Estado inicial
  const esDarkInicial = document.documentElement.classList.contains('dark');
  aplicarSeleccionVisual(esDarkInicial);

  optLight?.addEventListener('click', () => setTheme(false));
  optDark?.addEventListener('click', () => setTheme(true));
</script>
